# SIH26190 Backend Configuration

# === LLM (Grok via xAI API) ===
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=qwen/qwen3.8-27b

# === Corpus Configuration ===
# CORPUS_MODE: small (100 records, default) or full (1GB+)
CORPUS_MODE=small
# CORPUS_PATH: override corpus file path (optional)
# CORPUS_PATH=/path/to/custom/corpus.jsonl

# === Qdrant Vector Store ===
# RAG_USE_QDRANT: true (use BGE-M3 + Qdrant) or false (keyword fallback only)
RAG_USE_QDRANT=true
# QDRANT_PATH: path to Qdrant storage directory
# QDRANT_PATH=../investigation_dataset_engine/output/qdrant_storage
# QDRANT_COLLECTION: Qdrant collection name
QDRANT_COLLECTION=sih26189_evidence

# === Retrieval Settings ===
# RAG_TOP_K: number of evidence records to retrieve
RAG_TOP_K=10
# SEMANTIC_WEIGHT, ENTITY_WEIGHT, LEXICAL_WEIGHT: hybrid scoring weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
ENTITY_WEIGHT=0.3
LEXICAL_WEIGHT=0.1

# === Embedding Model ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# === Debug ===
# DEBUG_RAG: true to log full retrieval debug info
DEBUG_RAG=false
